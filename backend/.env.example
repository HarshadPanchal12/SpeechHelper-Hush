# Leave DENOISE_API_KEY empty for local use. Set it to require "Authorization: Bearer <key>".
DENOISE_API_KEY=
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=500
MAX_DURATION_MIN=120
CHUNK_SECONDS=30
JOB_TTL_SECONDS=1800
# deepfilternet (real model) | dryrun (no model, halves volume - for UI testing)
HUSH_ENGINE=deepfilternet
