# Where the Python denoising server runs (see ../backend).
BACKEND_URL=http://127.0.0.1:8000
# Only needed if you set DENOISE_API_KEY on the backend. Stays on the server, never sent to the browser.
BACKEND_API_KEY=

# Optional sign-in with Clerk. Leave both empty to run without accounts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
